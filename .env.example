# CacheGrid-Distributed Configuration
PORT=5000
NODE_ENV=production

# Persistence Tier
MONGODB_URI=mongodb://localhost:27017/cachegrid_distributed
REDIS_URL=redis://localhost:6379

# Cluster & Ring Parameters
NODE_ID=node-us-east-01
VIRTUAL_NODES_PER_HOST=128
DEFAULT_CACHE_TTL_SECONDS=3600
MAX_CACHE_CAPACITY_ITEMS=50000

# Write-Behind Persistence Engine
WRITE_BEHIND_BATCH_SIZE=100
WRITE_BEHIND_FLUSH_INTERVAL_MS=2000

# Security
CACHE_API_KEY=cachegrid_sec_token_8892
LOG_LEVEL=info
